{
  "name": "nachiketh-motion-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .evidence/build-ssr && node scripts/prerender.mjs && node tests/prerender.check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "content:export": "node scripts/export-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^8.6.2",
    "gsap": "^3.15.0",
    "katex": "^0.18.7",
    "mermaid": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "sanity": "^6.14.1",
    "styled-components": "^6.5.3",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "groq-js": "^2.0.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "simple-icons": "^16.31.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18.0"
  }
}
